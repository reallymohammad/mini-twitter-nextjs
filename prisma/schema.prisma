generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
 
 
}

model User {
  id            String   @id @default(cuid())
  fullName      String
  username      String   @unique
  email         String   @unique
  passwordHash  String
  bio           String?
  avatarUrl     String?
  coverImageUrl String?
  birthDate     DateTime?
  location      String?
  website       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
